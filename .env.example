# Agent platform (optional — for future Cursor SDK integration)
CURSOR_API_KEY=
LLM_MODEL=composer-2.5

# API server
API_PORT=3001
SESSIONS_DIR=./sessions
# Set to 1 to wipe all session folders (reports, screenshots, findings) every time the API
# server starts. Off by default — a dev-server restart should never silently destroy session
# data. Only enable this for a throwaway/CI environment where session data is never needed
# across a restart.
# CLEAR_SESSIONS_ON_START=1

# Web UI dev proxy target
VITE_API_URL=http://localhost:3001
# Optional: direct WebSocket URL (defaults to VITE_API_URL with ws:// scheme)
# VITE_WS_URL=ws://localhost:3001

# Optional integrations
JIRA_API_TOKEN=
SLACK_WEBHOOK_URL=

# Optional — Gemini vision API for the visual-review flow. Unset/invalid = that one flow
# skips gracefully; every other flow is unaffected.
GEMINI_API_KEY=
# Quota protection for visual-review (defaults shown — only override if needed):
# GEMINI_VISUAL_REVIEW_DAILY_LIMIT=15       # max Gemini calls per calendar day, across all sessions
# GEMINI_VISUAL_REVIEW_COOLDOWN_HOURS=6     # skip re-reviewing the same site's origin within this window
# Also only runs at standard/deep session depth — never at smoke/chaos — regardless of these settings.

# Target site credentials are per-session via UI, not .env
