# Agent platform (optional — for future Cursor SDK integration)
CURSOR_API_KEY=
LLM_MODEL=composer-2.5

# API server
API_PORT=3001
SESSIONS_DIR=./sessions
# Set to 1 to wipe all session folders (reports, screenshots, findings) every time the API
# server starts. Off by default — a dev-server restart should never silently destroy session
# data. Only enable this for a throwaway/CI environment where session data is never needed
# across a restart.
# CLEAR_SESSIONS_ON_START=1

# Web UI dev proxy target
VITE_API_URL=http://localhost:3001
# Optional: direct WebSocket URL (defaults to VITE_API_URL with ws:// scheme)
# VITE_WS_URL=ws://localhost:3001

# Optional integrations
JIRA_API_TOKEN=
SLACK_WEBHOOK_URL=

# Optional — an LLM API key, used for several independent, purely additive things:
#  1. The visual-review flow's screenshot analysis (standard/deep depth only).
#  2. One AI-assisted site-classification call per session, right after recon — replaces the
#     hardcoded keyword-scored rule set with real contextual judgment about what the site is
#     and what's worth testing on it. If this call is unavailable/invalid, the session falls
#     back to the deterministic rule-based classifier automatically — nothing here is required.
#  3. The agentic-explore flow (standard/deep depth only) — a live, per-step reasoning loop:
#     the model looks at the ACTUAL current page each step and decides the next action itself
#     (click/fill/select/stop), instead of running a pre-written script. Capped at 5 actions
#     per session. Every risky action still goes through the same human-confirmation gate as
#     every other flow, and high-risk/sensitive input fields are never offered to it at all.
#  4. The per-category application knowledge base (knowledge-base/<siteType>.md) — generated
#     once the first time a given category of site is seen, reused for every other site that
#     classifies into the same category afterward.
#  5. Report-generation AI dedup/summary/validator pass.
# Unset/invalid = all of the above skip gracefully; every other flow is unaffected either way.
#
# Set WHICHEVER ONE of these three you actually have a key for — provider is auto-detected in
# this order (first one present wins, so only set one):
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Quota protection for visual-review (defaults shown — only override if needed):
# GEMINI_VISUAL_REVIEW_DAILY_LIMIT=15       # max AI calls per calendar day, across all sessions
# GEMINI_VISUAL_REVIEW_COOLDOWN_HOURS=6     # skip re-reviewing the same site's origin within this window
# Also only runs at standard/deep session depth — never at smoke/chaos — regardless of these settings.

# Target site credentials are per-session via UI, not .env
